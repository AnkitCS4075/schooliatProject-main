NODE_ENV=development
# Port 4000 matches dashboard Next.js proxy. Use 3000 if running API standalone.
PORT=4000
API_URL=http://localhost:4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schooliat?schema=public"
JWT_SECRET="189f0c88c7e1878c82cf8dd41caf3a35ca70532352d0bfe8cb12c53ed9edc780"
JWT_EXPIRATION_TIME=3600
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# Production: also merged into CORS allowlist (no trailing slash). Example: https://app.schooliat.com
FRONTEND_URL=
# Mobile app name + Play Store link used in SMTP welcome emails (overrides the default https://play.google.com/store/apps/details?id=com.schoolit)
SCHOOLIAT_APP_NAME=SchooliAt
SCHOOLIAT_APP_LINK=https://play.google.com/store/apps/details?id=com.schoolit
# File storage: local (filesystem) | minio (local MinIO) | aws-s3 (AWS cloud)
FILE_STORAGE=minio
MINIO_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=schooliat-files
FILE_SIZE_LIMIT=10
FILE_PATH=files
AWS_S3_BUCKET=my-bucket
AWS_REGION=my-region
AWS_ACCESS_KEY_ID=aws-access-key-id
AWS_SECRET_ACCESS_KEY=aws-secret-access-key
LOG_LEVEL=debug

# Puppeteer Config
PUPPETEER_POOL_SIZE=1
