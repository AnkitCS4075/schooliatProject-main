  DRAFT
  CONTRACT_SENT
  CONTRACT_CONFIRMED
  COMPLETED
  CANCELLED

  @@map("onboarding_status")
}

model SchoolOnboarding {
  id                   String           @id @default(uuid())
  schoolName           String           @map("school_name")
  schoolAddress        String           @map("school_address")
  schoolContactNumber  String           @map("school_contact_number")
  principalPhone       String?          @map("principal_phone")
  managementPhone      String?          @map("management_phone")
  pointOfContactName   String?          @map("point_of_contact_name")
  pointOfContactDesignation String?     @map("point_of_contact_designation")
  concernedEmail       String           @map("concerned_email")
  pricingPerStudent    Decimal?         @db.Decimal(10, 2) @map("pricing_per_student")
  pricingPerMonth      Decimal?         @db.Decimal(10, 2) @map("pricing_per_month")
  relationshipManagerId String?         @map("relationship_manager_id")
  contractDurationYears Int            @default(1) @map("contract_duration_years")
  paymentMode          String?          @map("payment_mode")
  paymentTermsDays     Int?             @map("payment_terms_days")
  terminationNoticePeriod Int?          @map("termination_notice_period_months")
  status               OnboardingStatus @default(DRAFT)
  contractFileId       String?          @map("contract_file_id")
  contractAcceptedAt   DateTime?        @map("contract_accepted_at")
  schoolId             String?          @map("school_id")
  notes                String?
  createdBy            String           @map("created_by")
  updatedBy            String?          @map("updated_by")
  deletedBy            String?          @map("deleted_by")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime?        @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")
  school               School?          @relation(fields: [schoolId], references: [id])
  relationshipManager  User?            @relation(fields: [relationshipManagerId], references: [id])
  contractFile         File?            @relation(fields: [contractFileId], references: [id])

  @@index([status, deletedAt])
  @@index([schoolId, deletedAt])
  @@map("school_onboardings")
}

// ─── #16: Scholarships, Discounts & Late Fee Rules ─────────────────────

enum DiscountType {
  SCHOLARSHIP
  DISCOUNT
  SIBLING_DISCOUNT
  STAFF_WARD
  EARLY_BIRD
  OTHER

  @@map("discount_type")
}

enum LateFeeCalculationType {
  FIXED
  PERCENTAGE
  PER_DAY

  @@map("late_fee_calculation_type")
}

model FeeDiscount {
  id           String       @id @default(uuid())
  schoolId     String       @map("school_id")
  name         String
  description  String?
  type         DiscountType
  value        Decimal      @db.Decimal(10, 2)
  isPercentage Boolean      @default(false) @map("is_percentage")
  classId      String?      @map("class_id")
  isActive     Boolean      @default(true) @map("is_active")
  createdBy    String       @map("created_by")
  updatedBy    String?      @map("updated_by")
  deletedBy    String?      @map("deleted_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime?    @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  applications FeeDiscountApplication[]

  @@index([schoolId, deletedAt])
  @@map("fee_discounts")
}

model FeeDiscountApplication {
  id          String     @id @default(uuid())
  discountId  String     @map("discount_id")
  studentId   String     @map("student_id")
  installmentId String?  @map("installment_id")
  amount      Decimal    @db.Decimal(10, 2)
  reason      String?
  appliedBy   String     @map("applied_by")
  appliedAt   DateTime   @default(now()) @map("applied_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  discount    FeeDiscount @relation(fields: [discountId], references: [id])

  @@index([discountId])
  @@index([studentId])
  @@map("fee_discount_applications")
}

model LateFeeRule {
  id              String                @id @default(uuid())
  schoolId        String                @map("school_id")
  name            String
  description     String?
  calculationType LateFeeCalculationType @map("calculation_type")
  fixedAmount     Decimal?              @db.Decimal(10, 2) @map("fixed_amount")
  percentage      Decimal?              @db.Decimal(5, 2)
  amountPerDay    Decimal?              @db.Decimal(10, 2) @map("amount_per_day")
  gracePeriodDays Int                   @default(0) @map("grace_period_days")
  maxLateFee      Decimal?              @db.Decimal(10, 2) @map("max_late_fee")
  isActive        Boolean               @default(true) @map("is_active")
  createdBy       String                @map("created_by")
  updatedBy       String?               @map("updated_by")
  deletedBy       String?               @map("deleted_by")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime?             @updatedAt @map("updated_at")
  deletedAt       DateTime?             @map("deleted_at")

  @@index([schoolId, deletedAt])
  @@map("late_fee_rules")
}

// ─── #23: Gallery & Event Approval Status ──────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("approval_status")
}

// ─── Quotation Module ─────────────────────────────────────────────────

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  ACCEPTED
  CONVERTED
  CANCELLED
  CLOSED

  @@map("quotation_status")
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique @map("quotation_number")
  schoolId           String          @map("school_id")
  customerName       String          @map("customer_name")
  customerEmail      String?         @map("customer_email")
  customerPhone      String?         @map("customer_phone")
  customerAddress    String?         @map("customer_address")
  status             QuotationStatus @default(DRAFT)
  version            Int             @default(1)
  validUntil         DateTime?       @map("valid_until")
  description        String?
  subtotal           Decimal         @default(0) @db.Decimal(12, 2)
  discountPercent    Decimal         @default(0) @db.Decimal(5, 2) @map("discount_percent")
  discountAmount     Decimal         @default(0) @db.Decimal(12, 2) @map("discount_amount")
  taxPercent         Decimal         @default(0) @db.Decimal(5, 2) @map("tax_percent")
  taxAmount          Decimal         @default(0) @db.Decimal(12, 2) @map("tax_amount")
  totalAmount        Decimal         @default(0) @db.Decimal(12, 2) @map("total_amount")
  notes              String?
  termsAndConditions String?         @map("terms_and_conditions")
  rejectionReason    String?         @map("rejection_reason")
  cancelComment      String?         @map("cancel_comment")
  closeComment       String?         @map("close_comment")
  approvedById       String?         @map("approved_by_id")
  approvedAt         DateTime?       @map("approved_at")
  cancelledById      String?         @map("cancelled_by_id")
  cancelledAt        DateTime?       @map("cancelled_at")
  closedById         String?         @map("closed_by_id")
  closedAt           DateTime?       @map("closed_at")
  invoiceId          String?         @map("invoice_id")
  createdBy          String          @map("created_by")
  updatedBy          String?         @map("updated_by")
  deletedBy          String?         @map("deleted_by")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime?       @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")

  items              QuotationItem[]
  versions           QuotationVersion[]
  comments           QuotationComment[]
  school             School          @relation(fields: [schoolId], references: [id])

  @@index([schoolId, deletedAt])
  @@index([quotationNumber])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id              String  @id @default(uuid())
  quotationId     String  @map("quotation_id")
  description     String
  quantity        Int     @default(1)
  unitPrice       Decimal @db.Decimal(12, 2) @map("unit_price")
  taxPercent      Decimal @default(0) @db.Decimal(5, 2) @map("tax_percent")
  taxAmount       Decimal @default(0) @db.Decimal(12, 2) @map("tax_amount")
  totalAmount     Decimal @default(0) @db.Decimal(12, 2) @map("total_amount")
  sortOrder       Int     @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationVersion {
  id              String   @id @default(uuid())
  quotationId     String   @map("quotation_id")
  version         Int
  snapshot        Json
  changeNote      String?  @map("change_note")
  changedById     String?  @map("changed_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_versions")
}

model QuotationComment {
  id              String   @id @default(uuid())
  quotationId     String   @map("quotation_id")
  authorId        String   @map("author_id")
  authorName      String?  @map("author_name")
  content         String
  createdAt       DateTime @default(now()) @map("created_at")

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_comments")
}

// ─── Custom Roles ─────────────────────────────────────────────────────

model CustomRole {
  id              String       @id @default(uuid())
  name            String       @unique
  displayName     String       @map("display_name")
  description     String?
  schoolId        String?      @map("school_id")
  isSystem        Boolean      @default(false) @map("is_system")
  permissions     Permission[]
  createdBy       String       @map("created_by")
  updatedBy       String?      @map("updated_by")
  deletedBy       String?      @map("deleted_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime?    @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  @@index([schoolId, deletedAt])
  @@map("custom_roles")
}

// ─── Report Templates ─────────────────────────────────────────────────

model ReportTemplate {
  id              String   @id @default(uuid())
  name            String
  reportType      String   @map("report_type")
  schoolId        String?  @map("school_id")
  columns         Json
  filters         Json?
  isDefault       Boolean  @default(false) @map("is_default")
  createdBy       String   @map("created_by")
  updatedBy       String?  @map("updated_by")
  deletedBy       String?  @map("deleted_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  @@index([schoolId, reportType, deletedAt])
  @@map("report_templates")
}

// ─── Letterhead History ───────────────────────────────────────────────
// Managed so `prisma db push` never drops the runtime-ensured table that
// holds issued letterhead/serial history (see src/routers/letterhead.router.js).

model LetterheadHistory {
  id                   String    @id
  schoolId             String?   @map("school_id")
  createdBy            String    @map("created_by")
  createdByName        String?   @map("created_by_name")
  subject              String?
  dateValue            DateTime? @db.Date @map("date_value")
  content              String
  contentFormat        String?   @map("content_format")
  signatureName        String?   @map("signature_name")
  signatureDesignation String?   @map("signature_designation")
  generatedHtml        String    @map("generated_html")
  status               String?
  serialNumber         String?   @map("serial_number")
  documentType         String?   @map("document_type")
  issuedBy             String?   @map("issued_by")
  issuedByName         String?   @map("issued_by_name")
  issuedAt             DateTime? @db.Timestamp(6) @map("issued_at")
  isReprint            Boolean   @default(false) @map("is_reprint")
  createdAt            DateTime  @default(now()) @db.Timestamp(6) @map("created_at")

  @@index([createdAt])
  @@index([schoolId])
  @@index([createdBy])
  @@index([status])
  @@map("letterhead_history")
}
