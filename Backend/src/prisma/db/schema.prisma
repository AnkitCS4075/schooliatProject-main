  createdBy         String           @map("created_by")
  updatedBy         String?          @map("updated_by")
  deletedBy         String?          @map("deleted_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime?        @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  student           User             @relation("BonafideStudent", fields: [studentId], references: [id])
  school            School           @relation(fields: [schoolId], references: [id])
  file              File?            @relation(fields: [fileId], references: [id])
  creator           User             @relation("BonafideCreator", fields: [createdBy], references: [id])

  @@index([schoolId, deletedAt], map: "bonafide_certificates_school_deleted_at_idx")
