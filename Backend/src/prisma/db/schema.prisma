model GateEntry {
  id              String              @id @default(uuid())
  serialNo        Int                 @map("serial_no")
  category        GateEntryCategory
  name            String
  phone           String
  reason          String?
  personToMeet    String?             @map("person_to_meet")
  photoFileId     String?             @map("photo_file_id")
  inTime          DateTime            @default(now()) @map("in_time")
  outTime         DateTime?           @map("out_time")
  schoolId        String              @map("school_id")
  linkedLeadId    String?             @map("linked_lead_id")
  createdBy       String              @map("created_by")
  updatedBy       String?             @map("updated_by")
  deletedBy       String?             @map("deleted_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime?           @updatedAt @map("updated_at")
  deletedAt       DateTime?           @map("deleted_at")
  school          School              @relation(fields: [schoolId], references: [id])
  creator         User                @relation(fields: [createdBy], references: [id])
  linkedLead      CrmLead?            @relation(fields: [linkedLeadId], references: [id])

  @@unique([schoolId, serialNo], name: "gate_entries_unique_school_serial")
  @@index([schoolId, deletedAt], map: "gate_entries_school_deleted_at_idx")
  @@index([category, deletedAt], map: "gate_entries_category_deleted_at_idx")
  @@index([createdAt, deletedAt], map: "gate_entries_created_deleted_at_idx")
  @@map("gate_entries")
}

model CrmLead {
  id                String         @id @default(uuid())
  name              String
  phone             String
  source            CrmLeadSource
  stage             CrmLeadStage   @default(NEW)
  category          String?
  assignedToId      String?        @map("assigned_to_id")
  admittedStudentId String?        @map("admitted_student_id")
  schoolId          String         @map("school_id")
  nextFollowUpAt    DateTime?      @map("next_follow_up_at")
  createdBy         String         @map("created_by")
  updatedBy         String?        @map("updated_by")
  deletedBy         String?        @map("deleted_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime?      @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")
  school            School         @relation(fields: [schoolId], references: [id])
  assignedTo        User?          @relation("CrmAssignedTo", fields: [assignedToId], references: [id])
  creator           User           @relation(fields: [createdBy], references: [id])
  remarks           LeadRemark[]
  gateEntries       GateEntry[]

  @@index([schoolId, stage, deletedAt], map: "crm_leads_school_stage_deleted_at_idx")
  @@index([assignedToId, deletedAt], map: "crm_leads_assigned_deleted_at_idx")
  @@index([createdAt, deletedAt], map: "crm_leads_created_deleted_at_idx")
  @@map("crm_leads")
}

