generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model File {
  id            String         @id @default(uuid())
  extension     String
  name          String
  ownerId       String?        @map("owner_id")
  contentType   String         @map("content_type")
  size          Int
  createdBy     String         @map("created_by")
  updatedBy     String?        @map("updated_by")
  deletedBy     String?        @map("deleted_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime?      @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  galleryImages GalleryImage[]
  notes         Note[]
  syllabi       Syllabus[]
  bonafideCerts BonafideCertificate[]
  onboardingContracts SchoolOnboarding[]
  studentDocuments StudentDocument[]

  @@map("files")
}

model Template {
  id       String       @id @default(uuid())
  type     TemplateType
  path     String
  imageId  String?      @map("image_id")
  sampleId String?      @map("sample_id")
  title    String

  @@unique([type, path], name: "templates_unique_type_path")
  @@map("templates")
}

model Region {
  id         String     @id @default(uuid())
  name       String
  zoneHeadId String?    @map("zone_head_id")
  createdBy  String     @map("created_by")
  updatedBy  String?    @map("updated_by")
  deletedBy  String?    @map("deleted_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  zoneHead   User?      @relation("RegionZoneHead", fields: [zoneHeadId], references: [id])
  locations  Location[]
  schools    School[]
  users      User[]     @relation("RegionUsers")
  vendors    Vendor[]

  @@map("regions")
}

model Location {
  id         String    @id @default(uuid())
  name       String
  regionId   String    @map("region_id")
  employeeId String?   @map("employee_id")
  createdBy  String    @map("created_by")
  updatedBy  String?   @map("updated_by")
  deletedBy  String?   @map("deleted_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  employee   User?     @relation("EmployeeLocations", fields: [employeeId], references: [id])
  region     Region    @relation(fields: [regionId], references: [id])

  @@map("locations")
}

model Role {
  id          String       @id @default(uuid())
  name        RoleName     @unique
  permissions Permission[] @default([])
  createdBy   String       @map("created_by")
  updatedBy   String?      @map("updated_by")
  deletedBy   String?      @map("deleted_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime?    @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")
  users       User[]

  @@map("roles")
}

model School {
  id                      String                @id @default(uuid())
  name                    String
  code                    String                @unique
  address                 String[]              @unique
  email                   String                @unique
  phone                   String                @unique
  certificateLink         String?               @map("certificate_link")
  logoId                  String?               @map("logoId")
  gstNumber               String?               @map("gst_number")
  principalName           String?               @map("principal_name")
  principalEmail          String?               @map("principal_email")
  principalPhone          String?               @map("principal_phone")
  establishedYear         Int?                  @map("established_year")
  boardAffiliation        String?               @map("board_affiliation")
  studentStrength         Int?                  @map("student_strength")
  createdBy               String                @map("created_by")
  updatedBy               String?               @map("updated_by")
  deletedBy               String?               @map("deleted_by")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime?             @updatedAt @map("updated_at")
  deletedAt               DateTime?             @map("deleted_at")
  bankAccountNumber       String?               @map("bank_account_number")
  bankBranchName          String?               @map("bank_branch_name")
  bankIfscCode            String?               @map("bank_ifsc_code")
  bankName                String?               @map("bank_name")
  upiId                   String?               @map("upi_id")
  regionId                String?               @map("region_id")
  contractAccepted        Boolean               @default(false) @map("contract_accepted")
  contractAcceptedAt      DateTime?             @map("contract_accepted_at")
  contractVersion         Int?                  @default(1) @map("contract_version")
  activationStatus        SchoolActivationStatus @default(PENDING_ACTIVATION) @map("activation_status")
  circulars               Circular[]
  schoolEmergencyContacts EmergencyContact[]    @relation("SchoolEmergencyContacts")
  faqs                    FAQ[]
  galleries               Gallery[]
  grievances              Grievance[]
  invoices                Invoice[]
  libraryBooks            LibraryBook[]
  notes                   Note[]
  receipts                Receipt[]
  routes                  Route[]
  region                  Region?               @relation(fields: [regionId], references: [id])
  syllabi                 Syllabus[]
  schoolTCs               TransferCertificate[] @relation("SchoolTCs")
  users                   User[]
  inventoryItems          InventoryItem[]
  schoolCouriers          SchoolCourier[]
  gateEntries             GateEntry[]
  crmLeads                CrmLead[]
  bonafideCertificates    BonafideCertificate[]
  otherIncomes            OtherIncome[]
  accounts                Account[]
  journalEntries          JournalEntry[]
  openingBalances         OpeningBalance[]
  schoolOnboardings       SchoolOnboarding[]
  quotations              Quotation[]

  @@map("schools")
}

model Class {
  id             String           @id @default(uuid())
  grade          String
  division       String?
  /// Optional default total annual fee (whole currency units) for new student fee plans in this class.
  defaultAnnualFee  Int?          @map("default_annual_fee")
  /// Optional default monthly fee; if set without annual, annual total = monthly × installment count from school settings.
  defaultMonthlyFee Int?          @map("default_monthly_fee")
  /// Optional breakdown of annual fee (e.g. tuition, transport). Sum is used as annual total when non-empty; overrides defaultAnnualFee.
  defaultFeeComponents Json?      @map("default_fee_components")
  schoolId       String           @map("school_id")
  classTeacherId String?          @map("class_teacher_id")
  createdBy      String           @map("created_by")
  updatedBy      String?          @map("updated_by")
  deletedBy      String?          @map("deleted_by")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime?        @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  attendances    Attendance[]
  galleries      Gallery[]
  marks          Marks[]
  notes          Note[]
  results        Result[]
  students       StudentProfile[]
  syllabi        Syllabus[]
  timetable      Timetable[]

  @@unique([grade, division, schoolId], name: "classes_unique_grade_division_school_id")
  @@map("classes")
}

model Subject {
  id             String          @id @default(uuid())
  name           String
  code           String?
  description    String?
  schoolId       String          @map("school_id")
  createdBy      String          @map("created_by")
  updatedBy      String?         @map("updated_by")
  deletedBy      String?         @map("deleted_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime?       @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  homeworks      Homework[]
  marks          Marks[]
  notes          Note[]
  syllabi        Syllabus[]
  timetableSlots TimetableSlot[]

  @@unique([name, schoolId], name: "subjects_unique_name_school_id")
  @@map("subjects")
}

model User {
  id                         String                @id @default(uuid())
  publicUserId               String                @unique(map: "users_unique_public_user_id") @map("public_user_id")
  userType                   UserType              @map("user_type")
  email                      String                @unique(map: "users_unique_email")
  password                   String?
  firstName                  String                @map("first_name")
  lastName                   String?               @map("last_name")
  contact                    String
  gender                     Gender
  dateOfBirth                DateTime              @map("date_of_birth")
  address                    String[]
  aadhaarId                  String?               @unique @map("aadhaar_id")
  registrationPhotoId        String?               @map("registration_photo_id")
  idPhotoId                  String?               @map("id_photo_id")
  roleId                     String                @map("role_id")
  schoolId                   String?               @map("school_id")
  assignedRegionId           String?               @map("assigned_region_id")
  createdBy                  String                @map("created_by")
  updatedBy                  String?               @map("updated_by")
  deletedBy                  String?               @map("deleted_by")
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime?             @updatedAt @map("updated_at")
  deletedAt                  DateTime?             @map("deleted_at")
  permissions                Permission[]          @default([])
  markedAttendances          Attendance[]          @relation("MarkedAttendances")
  studentAttendances         Attendance[]          @relation("StudentAttendances")
  auditLogs                  AuditLog[]            @relation("AuditLogs")
  chatbotConversations       ChatbotConversation[]
  studentEmergencyContacts   EmergencyContact[]    @relation("StudentEmergencyContacts")
  grievanceComments          GrievanceComment[]    @relation("GrievanceCommentAuthor")
  createdGrievances          Grievance[]           @relation("GrievanceCreator")
  studentHomeworkSubmissions HomeworkSubmission[]  @relation("StudentHomeworkSubmissions")
  teacherHomeworks           Homework[]            @relation("TeacherHomeworks")
  leaveBalances              LeaveBalance[]        @relation("UserLeaveBalances")
  approvedLeaveRequests      LeaveRequest[]        @relation("ApprovedLeaveRequests")
  leaveRequests              LeaveRequest[]        @relation("UserLeaveRequests")
  libraryIssues              LibraryIssue[]
  libraryReservations        LibraryReservation[]
  assignedLocations          Location[]            @relation("EmployeeLocations")
  studentMarks               Marks[]               @relation("StudentMarks")
  sentMessages               Message[]             @relation("SentMessages")
  userNotifications          Notification[]        @relation("UserNotifications")
  childLinks                 ParentChildLink[]     @relation("ChildLinks")
  parentLinks                ParentChildLink[]     @relation("ParentLinks")
  passwordResetToken         PasswordResetToken?   @relation("PasswordResetTokens")
  publishedResults           Result[]              @relation("PublishedResults")
  studentResults             Result[]              @relation("StudentResults")
  staffProfile               StaffProfile?
  studentProfile             StudentProfile?
  teacherProfile             TeacherProfile?
  teacherTimetableSlots      TimetableSlot[]       @relation("TeacherTimetableSlots")
  studentTCs                 TransferCertificate[] @relation("StudentTCs")
  assignedRegion             Region?               @relation("RegionUsers", fields: [assignedRegionId], references: [id])
  regionAsZoneHead           Region[]              @relation("RegionZoneHead")
  role                       Role                  @relation(fields: [roleId], references: [id])
  school                     School?               @relation(fields: [schoolId], references: [id])
  assignedVendors            Vendor[]              @relation("EmployeeVendors")
  salaryPayments             SalaryPayments[]
  assignedLeads              CrmLead[]             @relation("CrmAssignedTo")
  createdLeads               CrmLead[]
  leadRemarks                LeadRemark[]
  createdGateEntries         GateEntry[]
  createdBonafideCerts       BonafideCertificate[] @relation("BonafideCreator")
  studentBonafideCerts       BonafideCertificate[] @relation("BonafideStudent")
  receivedOtherIncomes       OtherIncome[]
  managedOnboardings         SchoolOnboarding[]
  studentDocuments           StudentDocument[]

  @@index([schoolId, deletedAt])
  @@index([roleId, userType, deletedAt])
  @@index([schoolId, roleId, deletedAt])
  @@index([deletedAt])
  @@map("users")
}

model StudentProfile {
  id                String            @id @default(uuid())
  userId            String            @unique @map("user_id")
  rollNumber        Int               @map("roll_number")
  apaarId           String?           @unique @map("apaar_id")
  classId           String            @map("class_id")
  transportId       String?           @map("transport_id")
  fatherName        String            @map("father_name")
  motherName        String            @map("mother_name")
  fatherContact     String            @map("father_contact")
  motherContact     String            @map("mother_contact")
  fatherOccupation  String?           @map("father_occupation")
  annualIncome      Decimal?          @map("annual_income") @db.Decimal(15, 0)
  accommodationType AccommodationType @map("accommodation_type")
  bloodGroup        BloodGroup?       @map("blood_group")
  previousSchoolName      String?     @map("previous_school_name")
  previousSchoolBoard     String?     @map("previous_school_board")
  previousClassAttended   String?     @map("previous_class_attended")
  previousYearOfLeaving   String?     @map("previous_year_of_leaving")
  previousSchoolTcNumber  String?     @map("previous_school_tc_number")
  createdBy         String            @map("created_by")
  updatedBy         String?           @map("updated_by")
  deletedBy         String?           @map("deleted_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime?         @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")
  class             Class             @relation(fields: [classId], references: [id])
  transport         Transport?        @relation(fields: [transportId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumberHistory RollNumberHistory[]

  @@map("student_profiles")
}

enum StudentDocumentCategory {
  AADHAAR
  PREVIOUS_SCHOOL
  OTHERS

  @@map("student_document_category")
}

model StudentDocument {
  id         String                  @id @default(uuid())
  userId     String                  @map("user_id")
  category   StudentDocumentCategory
  label      String?                 @map("label")
  fileId     String?                 @map("file_id")
  fileUrl    String?                 @map("file_url")
  uploadedBy String                  @map("uploaded_by")
  createdAt  DateTime                @default(now()) @map("created_at")
  deletedAt  DateTime?               @map("deleted_at")
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  file       File?                   @relation(fields: [fileId], references: [id])

  @@index([userId, category, deletedAt])
  @@map("student_documents")
}

enum RollNumberChangeAction {
  AUTO_ASSIGNED
  MANUAL_OVERRIDE
  REARRANGED

  @@map("roll_number_change_action")
}

model RollNumberHistory {
  id             String                  @id @default(uuid())
  studentUserId  String                  @map("student_user_id")
  classId        String                  @map("class_id")
  oldRollNumber  Int?                    @map("old_roll_number")
  newRollNumber  Int                     @map("new_roll_number")
  action         RollNumberChangeAction
  changedBy      String                  @map("changed_by")
  changedAt      DateTime                @default(now()) @map("changed_at")
  studentProfile StudentProfile          @relation(fields: [studentUserId], references: [userId], onDelete: Cascade)

  @@index([studentUserId, changedAt])
  @@index([classId, changedAt])
  @@map("roll_number_histories")
}

enum SchoolActivationStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED

  @@map("school_activation_status")
}

model TeacherProfile {
  id                   String      @id @default(uuid())
  userId               String      @unique @map("user_id")
  designation          String?
  highestQualification String      @map("highest_qualification")
  university           String
  yearOfPassing        Int         @map("year_of_passing")
  grade                String
  transportId          String?     @map("transport_id")
  panCardNumber        String?     @map("pan_card_number")
  bloodGroup           BloodGroup? @map("blood_group")
  createdBy            String      @map("created_by")
  updatedBy            String?     @map("updated_by")
  deletedBy            String?     @map("deleted_by")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime?   @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")
  basicSalary          Int?        @map("basic_salary")
  /// Free-text subjects taught (e.g. "Mathematics, Science") — shown on teacher list and edit form.
  subjects             String?     @db.Text
  transport            Transport?  @relation(fields: [transportId], references: [id])
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model StaffProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  designation String?
  basicSalary Int?      @map("basic_salary")
  createdBy   String    @map("created_by")
  updatedBy   String?   @map("updated_by")
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model Transport {
  id                   String               @id @default(uuid())
  type                 TransportType
  licenseNumber        String               @unique @map("license_number")
  vehicleNumber        String?              @map("vehicle_number")
  schoolId             String               @map("school_id")
  ownerFirstName       String               @map("owner_first_name")
  ownerLastName        String               @map("owner_last_name")
  driverFirstName      String               @map("driver_first_name")
  driverLastName       String               @map("driver_last_name")
  driverDateOfBirth    DateTime             @map("driver_date_of_birth")
  driverContact        String               @map("driver_contact")
  driverGender         Gender               @map("driver_gender")
  driverPhotoLink      String?              @map("driver_photo_link")
  conductorFirstName   String               @map("conductor_first_name")
  conductorLastName    String               @map("conductor_last_name")
  conductorDateOfBirth DateTime?            @map("conductor_date_of_birth")
  conductorContact     String               @map("conductor_contact")
  conductorGender      Gender               @map("conductor_gender")
  conductorPhotoLink   String?              @map("conductor_photo_link")
  createdBy            String               @map("created_by")
  updatedBy            String?              @map("updated_by")
  deletedBy            String?              @map("deleted_by")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime?            @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")
  busSerialNumber      String?              @map("bus_serial_number")
  routes               Route[]
  students             StudentProfile[]
  teachers             TeacherProfile[]
  vehicleMaintenances  VehicleMaintenance[]

  @@unique([vehicleNumber, schoolId], name: "transports_unique_vehicle_number_school_id")
  @@map("transports")
}

model Vendor {
  id         String     @id @default(uuid())
  name       String
  email      String?
  contact    String
  address    String[]
  status     LeadStatus @default(NEW) @map("status")
  comments   String?
  regionId   String     @map("region_id")
  employeeId String?    @map("employee_id")
  createdBy  String     @map("created_by")
  updatedBy  String?    @map("updated_by")
  deletedBy  String?    @map("deleted_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  invoices   Invoice[]
  receipts   Receipt[]
  employee   User?      @relation("EmployeeVendors", fields: [employeeId], references: [id])
  region     Region     @relation(fields: [regionId], references: [id])

  @@map("vendors")
}

model Settings {
  id                       String    @id @default(uuid())
  schoolId                 String?   @map("school_id")
  studentFeeInstallments   Int       @default(12) @map("student_fee_installments")
  studentFeeAmount         Int?      @map("student_fee_amount")
  currentInstallmentNumber Int       @map("current_installement_number")
  logoId                   String?   @map("logo_id")
  createdBy                String    @map("created_by")
  updatedBy                String?   @map("updated_by")
  deletedBy                String?   @map("deleted_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime? @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")
  platformConfig           Json?     @map("platform_config")
  /// When set (school settings only), deletion OTP emails go here instead of the admin login email.
  deletionOtpEmail         String?   @map("deletion_otp_email")
  feeReceiptNumberPrefix   String?   @default("REC") @map("fee_receipt_number_prefix")
  feeReceiptNextSequence   Int?      @default(1) @map("fee_receipt_next_sequence")
  feeReceiptUseGst         Boolean   @default(false) @map("fee_receipt_use_gst")
  feeReceiptCgstPercent    Decimal?  @map("fee_receipt_cgst_percent") @db.Decimal(5, 2)
  feeReceiptSgstPercent    Decimal?  @map("fee_receipt_sgst_percent") @db.Decimal(5, 2)
  feeReceiptPanCardNumber  String?   @map("fee_receipt_pan_card_number")
  /// AES-256-GCM encrypted SMTP password for platform (school_id null). Never store plaintext in platform_config.
  platformSmtpPasswordEnc  String?   @map("platform_smtp_password_enc") @db.Text
  /// Geo-fencing: school location for staff attendance
  geoFenceLatitude         Float?    @map("geo_fence_latitude")
  geoFenceLongitude        Float?    @map("geo_fence_longitude")
  geoFenceRadiusMeters     Int?      @default(200) @map("geo_fence_radius_meters")
  geoFenceEnabled          Boolean   @default(false) @map("geo_fence_enabled")

  // Company configuration
  companyName              String?   @map("company_name")
  companyGstin             String?   @map("company_gstin")
  companyPan               String?   @map("company_pan")
  companyCin               String?   @map("company_cin")
  companyPhone             String?   @map("company_phone")
  companyEmail             String?   @map("company_email")
  companyWebsite           String?   @map("company_website")
  companyAddress           String?   @db.Text @map("company_address")

  // Bank details
  companyBankName          String?   @map("company_bank_name")
  companyBankAccount       String?   @map("company_bank_account")
  companyBankIfsc          String?   @map("company_bank_ifsc")
  companyBankBranch        String?   @map("company_bank_branch")
  companyBankQrUrl         String?   @map("company_bank_qr_url")

  // Signature & Stamp
  signatureImageUrl        String?   @map("signature_image_url")
  signatureName            String?   @map("signature_name")
  signatureDesignation     String?   @map("signature_designation")
  stampImageUrl            String?   @map("stamp_image_url")

  // Quotation configuration
  quotationPrefix          String?   @default("QUO") @map("quotation_prefix")
  quotationNextSequence    Int?      @default(1) @map("quotation_next_sequence")
  defaultQuotationTerms    String?   @db.Text @map("default_quotation_terms")
  defaultQuotationNotes    String?   @db.Text @map("default_quotation_notes")
  quotationValidityDays    Int?      @default(30) @map("quotation_validity_days")

  // Invoice configuration
  invoicePrefix            String?   @default("INV") @map("invoice_prefix")
  invoiceNextSequence      Int?      @default(1) @map("invoice_next_sequence")

  // Tax configuration
  taxConfigGstPercent      Decimal?  @map("tax_config_gst_percent") @db.Decimal(5, 2)
  taxConfigCgstPercent     Decimal?  @map("tax_config_cgst_percent") @db.Decimal(5, 2)
  taxConfigSgstPercent     Decimal?  @map("tax_config_sgst_percent") @db.Decimal(5, 2)
  taxConfigIgstPercent     Decimal?  @map("tax_config_igst_percent") @db.Decimal(5, 2)

  // Theme configuration
  themePrimaryColor        String?   @map("theme_primary_color")
  themeSecondaryColor      String?   @map("theme_secondary_color")
  themeAccentColor         String?   @map("theme_accent_color")

  @@map("settings")
}

model OtherIncome {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  title        String
  description  String?
  amount       Decimal  @db.Decimal(12, 2)
  category     String?
  source       String?
  receivedAt   DateTime @default(now()) @map("received_at")
  receivedBy   String   @map("received_by")
  attachmentId String?  @map("attachment_id")
  createdBy    String   @map("created_by")
  updatedBy    String?  @map("updated_by")
  deletedBy    String?  @map("deleted_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  school       School   @relation(fields: [schoolId], references: [id])
  receiver     User     @relation(fields: [receivedBy], references: [id])

  @@index([schoolId, deletedAt])
  @@index([receivedAt, deletedAt])
  @@map("other_incomes")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE

  @@map("account_type")
}

model Account {
  id          String      @id @default(uuid())
  schoolId    String      @map("school_id")
  code        String
  name        String
  type        AccountType
  parentCode  String?     @map("parent_code")
  isGroup     Boolean     @default(false) @map("is_group")
  isActive    Boolean     @default(true) @map("is_active")
  createdBy   String      @map("created_by")
  updatedBy   String?     @map("updated_by")
  deletedBy   String?     @map("deleted_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime?   @updatedAt @map("updated_at")
